  // Elements that can't have anything in them.
  @Markup br(attributes: List<Attribute> = []): Unit = element("br", attributes)
  @Markup hr(attributes: List<Attribute> = []): Unit = element("hr", attributes)
  @Markup input(attributes: List<Attribute> = []): Unit = element("input", attributes)
