import uk.m4xy.html.Htmls.*

// An element for each tag, with its attributes, and what the block adds in it: div { p { text("hi") } },
// ul([classes(["plain"])]) { li { text("one") } }. main is mainElement, as main is a program's.
module Tags {
  // A link to href.
  @Markup a<@E>(
    href: String,
    attributes: List<Attribute> = [],
    block: @Markup @E () -> Unit = () -> Unit,
  ): Unit = element("a", [attribute("href", href)] + attributes, block)

  // An image, from src, which alt says in words.
  @Markup img(src: String, alt: String, attributes: List<Attribute> = []): Unit =
    element("img", [attribute("src", src), attribute("alt", alt)] + attributes)

  @Markup mainElement<@E>(
    attributes: List<Attribute> = [],
    block: @Markup @E () -> Unit = () -> Unit,
  ): Unit = element("main", attributes, block)

  @Markup abbr<@E>(
    attributes: List<Attribute> = [],
    block: @Markup @E () -> Unit = () -> Unit,
  ): Unit = element("abbr", attributes, block)

  @Markup article<@E>(
    attributes: List<Attribute> = [],
    block: @Markup @E () -> Unit = () -> Unit,
  ): Unit = element("article", attributes, block)

  @Markup aside<@E>(
